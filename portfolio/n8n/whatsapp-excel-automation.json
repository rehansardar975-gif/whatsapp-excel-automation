      "parameters": {
        "method": "GET",
        "url": "={{ $('Settings').first().json.sheetreachUrl }}/api/campaigns/{{ $('Start sending (WhatsApp provider)').first().json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
