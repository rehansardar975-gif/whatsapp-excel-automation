              "value": "n8n"
            }
          ]
        },
        "options": {}
      },
      "id": "5e2b6928-7cc3-4a63-a996-b88e98caa8fa",
      "name": "Check progress",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        925
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "47c337b7-f8f9-410b-94f5-8456ef3c1486",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "843cd797-bf09-4399-b314-6c540ac3b6ee",
      "name": "Campaign finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1360,
        925
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Settings').first().json.sheetreachUrl }}/api/campaigns/{{ $json.id }}/export?format=xlsx",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation",
              "value": "n8n"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "c52b7ccc-8512-420f-87eb-0d36e81dc74e",
      "name": "Download results (Excel)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1580,
        850
      ]
    },
    {
      "parameters": {
        "jsCode": "// One clear summary of the whole run, with the Excel results attached.\nconst s = $('Settings').first().json;\nconst q = $('Data quality report').first().json;\nconst c = $('Campaign finished?').first().json;\nconst r = c.report;\nconst demo = c.provider === 'demo';\nreturn [{\n  json: {\n    result: `Campaign \"${c.name}\" complete`,\n    whatsapp_provider: demo ? 'Demo provider — sending simulated, no real WhatsApp messages were sent'\n                            : 'WhatsApp Business Cloud API',\n    file: q.file,\n    cleaning: {\n      rows_in_file: q.rows_in_file,\n      duplicates_removed: q.duplicates_removed,\n      invalid_numbers: q.invalid_numbers,\n      missing_numbers: q.missing_numbers,\n      blocked_do_not_contact: q.do_not_contact,\n      imported: q.will_import,\n    },\n    campaign: {\n      contacts: r.total, processed: r.processed, sent: r.sent, delivered: r.delivered,\n      failed: r.failed, skipped: r.skipped, opted_out: r.opted_out, retried: r.retried,\n    },\n    why_failed: r.failed_reasons,\n    why_skipped: r.skipped_reasons,\n    open_in_sheetreach: `${s.sheetreachUrl}/campaigns/${c.id}`,\n  },\n  binary: $input.first().binary,\n}];"
      },
      "id": "82cf4645-51d9-4ef9-a802-5cf4ecd5a4a9",
      "name": "Final report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        850
      ]
    },
    {
      "parameters": {
        "jsCode": "// Ends the run cleanly when there is nobody new to message.\nconst q = $('Data quality report').first().json;\nreturn [{ json: {\n  result: 'No campaign started',\n  reason: q.will_import === 0\n    ? 'Every contact in this file is a duplicate, already saved, invalid or on the Do Not Contact list.'\n    : 'No imported contact has a WhatsApp opt-in on record yet.',\n  file: q.file,\n  rows_in_file: q.rows_in_file,\n}}];"
      },
      "id": "7dfa0f72-ea1b-46f9-b499-7073270a7dde",
      "name": "Nothing new to send",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        550
      ]
    }
