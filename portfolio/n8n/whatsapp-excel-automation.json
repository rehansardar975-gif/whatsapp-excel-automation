              "name": "X-Automation",
              "value": "n8n"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ consent_confirmed: $('Settings').first().json.consentConfirmed }) }}"
      },
