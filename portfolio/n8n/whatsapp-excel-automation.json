              "leftValue": "={{ $json.ready }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "71698cc7-bf98-4d51-90c3-9c40fa04aa6f",
      "name": "Anyone ready to message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Settings').first().json.sheetreachUrl }}/api/templates",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation",
              "value": "n8n"
            }
          ]
        },
        "options": {}
      },
      "id": "d2847a01-92ac-432c-9bdc-7ec3daf8b0de",
      "name": "Load message templates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        925
      ]
    },
    {
      "parameters": {
        "jsCode": "// Choose the message template named in Settings.\nconst wanted = $('Settings').first().json.messageName;\nconst all = $input.all().map(i => i.json);\nconst t = all.find(x => x.name === wanted);\nif (!t) {\n  throw new Error(`Message \"${wanted}\" not found. Available: ${all.map(x => x.name).join(', ')}`);\n}\nreturn [{ json: { template_id: t.id, template_name: t.name, personalised_fields: t.fields, body: t.body } }];"
      },
      "id": "767f9540-a7b8-4f60-ada8-01387a45368b",
      "name": "Pick message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        925
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.sheetreachUrl }}/api/campaigns",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Automation",
              "value": "n8n"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $('Settings').first().json.campaignName, template_id: $json.template_id, audience: { batch_id: $('Data quality report').first().json.import_id } }) }}"
      },
      "id": "d27ca039-8d47-4b55-85c0-c304820b2828",
      "name": "Create personalised campaign",
