      "id": "c9587b38-046b-4131-9848-1ce5c52969c4",
      "name": "Upload & clean in SheetReach",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        375
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turn SheetReach's analysis into a short, readable quality report.\nconst r = $input.first().json;\nconst s = r.summary || {};\nif (s.error) {\n  throw new Error(`SheetReach could not read \"${r.file_name}\": ${s.error}`);\n}\nreturn [{ json: {\n  import_id: r.id,\n  file: r.file_name,\n  rows_in_file: s.total,\n  ready_to_message: s.ready,\n  need_opt_in: s.needs_opt_in,\n  duplicates_removed: s.duplicate,\n  invalid_numbers: s.invalid,\n  missing_numbers: s.missing,\n  do_not_contact: s.do_not_contact,\n  already_saved: s.existing,\n  will_import: s.will_import,\n  phone_column: r.mapping.phone,\n}}];"
      },
      "id": "1d2b6e71-710c-4b28-b663-5adb4d953e16",
      "name": "Data quality report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        375
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "5b8f85f7-6a59-4052-9daa-2fd23979882e",
              "leftValue": "={{ $json.will_import }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "127aad22-0a27-487e-8351-321e4b98ac8a",
      "name": "New contacts to import?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        375
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.sheetreachUrl }}/api/imports/{{ $json.import_id }}/commit",
