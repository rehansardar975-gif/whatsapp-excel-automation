# Copy to .env (or export) — never commit real values.
# Demo Mode is the default. Live sending needs ALL of the WhatsApp values below.
WHATSAPP_MODE=demo                 # demo | cloud_api
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=               # verifies X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN=change-me    # used when Meta verifies the webhook URL
WHATSAPP_API_VERSION=v21.0
DATABASE_URL=                      # default: SQLite file in backend/data/. Postgres: postgresql+psycopg://...
DEFAULT_COUNTRY=AE
DEMO_SEND_DELAY=0.12               # seconds between simulated sends (so progress is visible)
MAX_RETRIES=2
CORS_ORIGINS=http://localhost:5173
